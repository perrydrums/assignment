<div class="terminal" data-controller="clipboard" data-clipboard-text-value="{{ view.cliCommand }}">
    <div class="terminal__bar">
        <span class="terminal__dots" aria-hidden="true"><span></span><span></span><span></span></span>
        <code class="terminal__command"><span class="terminal__prompt" aria-hidden="true">$</span> {{ view.cliCommand }}</code>
        <button type="button" class="copy-button" data-action="clipboard#copy">
            {{ include('_icon.html.twig', {name: 'copy'}) }}
            <span data-clipboard-target="label">Copy command</span>
        </button>
    </div>
    <pre class="terminal__output" tabindex="0" aria-label="Console output"><code>{{ view.consoleOutput }}</code></pre>
</div>
<p class="results__footnote">
    {{ include('_icon.html.twig', {name: 'terminal'}) }}
    The report <code>app:analyze-exam</code> prints for this workbook, produced by the same code as the CLI.
</p>
