{% extends 'base.html.twig' %}

{% block title %}{{ 'upload.title'|trans }}{% endblock %}

{% block body %}
    <header class="hero">
        {{ include('_hero_backdrop.html.twig') }}
        <div class="container topbar" data-controller="theme-switch">
            {{ include('_topbar_brand.html.twig') }}
            <div class="topbar__tools">
                {{ include('_theme_switch.html.twig') }}
                {{ include('_language_switch.html.twig') }}
                <p class="topbar__note">{{ include('_icon.html.twig', {name: 'shield'}) }} {{ 'upload.private'|trans }}</p>
            </div>
        </div>
        <div class="container hero__content">
            <p class="eyebrow eyebrow--on-dark">{{ 'upload.eyebrow'|trans }}</p>
            <h1 class="hero__title">
                {%- for word in 'upload.headline'|trans|split(' ') -%}
                    <span class="reveal-word" style="--i: {{ loop.index0 }}">{{ word }}</span>{{ not loop.last ? ' ' }}
                {%- endfor -%}
            </h1>
            <p class="hero__lead">{{ 'upload.lead'|trans }}</p>
        </div>
    </header>

    <main id="main" class="container page page--upload">
        {% for message in app.flashes('error') %}
            <p class="field-errors" role="alert">{{ message|trans }}</p>
        {% endfor %}

        {{ form_start(form, {attr: {
            class: 'upload-card',
            'data-controller': 'upload',
            'data-action': 'upload#submit',
            'data-upload-max-bytes-value': 10000000,
            'data-upload-required-message-value': 'upload.error_required'|trans,
            'data-upload-type-message-value': 'upload.error_type'|trans,
            'data-upload-size-message-value': 'upload.error_size'|trans,
            'data-upload-busy-message-value': 'upload.busy'|trans,
        }}) }}
            {% if form.vars.errors|length > 0 %}
                <div class="upload-card__errors">{{ form_errors(form) }}</div>
            {% endif %}
            <div class="upload-card__grid">
                <section class="upload-step" aria-labelledby="step-file">
                    <h2 class="step-title" id="step-file"><span class="step-title__number">1</span> {{ 'upload.step_file'|trans }}</h2>

                    <label class="dropzone" data-upload-target="dropzone"
                           data-action="dragenter->upload#dragOver dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop">
                        {{ form_widget(form.workbook, {required: false, attr: {class: 'visually-hidden', 'aria-required': 'true', 'data-upload-target': 'input', 'data-action': 'upload#update'}}) }}
                        <span class="dropzone__icon">{{ include('_icon.html.twig', {name: 'upload'}) }}</span>
                        <span class="dropzone__title">{{ 'upload.drop_title'|trans }}</span>
                        <span class="dropzone__hint">{{ 'upload.drop_or'|trans }} <span class="dropzone__browse">{{ 'upload.browse'|trans }}</span></span>
                        <span class="dropzone__formats">{{ 'upload.formats'|trans }}</span>
                    </label>

                    <div class="file-chip" data-upload-target="selected" hidden>
                        <span class="file-chip__icon">{{ include('_icon.html.twig', {name: 'sheet'}) }}</span>
                        <span class="file-chip__details">
                            <strong class="file-chip__name" data-upload-target="fileName"></strong>
                            <span class="file-chip__meta"><span data-upload-target="fileSize"></span> · {{ 'upload.ready'|trans }}</span>
                        </span>
                        <span class="file-chip__check" aria-hidden="true">{{ include('_icon.html.twig', {name: 'check'}) }}</span>
                        <button type="button" class="icon-button" data-action="upload#clear" aria-label="{{ 'upload.remove_file'|trans }}">
                            {{ include('_icon.html.twig', {name: 'x'}) }}
                        </button>
                    </div>

                    <p class="field-errors" data-upload-target="error" role="alert" hidden></p>
                    {{ form_errors(form.workbook) }}

                    <details class="format-help">
                        <summary>{{ include('_icon.html.twig', {name: 'info'}) }} {{ 'upload.layout_toggle'|trans }}</summary>
                        <div class="format-help__body">
                            <table class="format-help__table">
                                <tr><th>ID</th><th>{{ 'upload.layout_question'|trans }} 1</th><th>{{ 'upload.layout_question'|trans }} 2</th><th>…</th></tr>
                                <tr><th>{{ 'upload.layout_max'|trans }}</th><td>1</td><td>3</td><td>…</td></tr>
                                <tr><th>{{ 'upload.layout_student'|trans }}</th><td>1</td><td>1.2</td><td>…</td></tr>
                            </table>
                            <p>{{ 'upload.layout_help'|trans }}</p>
                        </div>
                    </details>
                </section>

                <section class="upload-step upload-step--caesura" aria-labelledby="step-caesura"
                         data-controller="caesura"
                         data-caesura-index-value="{{ form.caesura.points|length }}"
                         data-caesura-pass-word-value="{{ 'chart.pass'|trans }}"
                         data-caesura-default-points-value="{{ default_caesura.points|map(point => {percentage: point.percentage, grade: point.grade})|json_encode }}"
                         data-caesura-default-pass-value="{{ default_caesura.passPercentage }}">
                    <h2 class="step-title" id="step-caesura"><span class="step-title__number">2</span> {{ 'upload.step_scale'|trans }}</h2>
                    <p class="upload-step__intro">{{ 'upload.scale_intro'|trans }} <a href="{{ path('app_analysis_help', {_locale: app.locale}) }}#grading-scale">{{ 'upload.scale_help'|trans }}</a></p>

                    {{ include('analysis/_caesura_editor.html.twig', {points: form.caesura.points, pass: form.caesura.passPercentage}) }}
                </section>
            </div>

            <footer class="upload-card__footer">
                <p class="upload-card__privacy">{{ include('_icon.html.twig', {name: 'shield'}) }} {{ 'upload.privacy'|trans }}</p>
                <div class="upload-card__actions">
                    {% if sample_available %}
                        <a class="button button--ghost" href="{{ path('app_analysis_sample', {_locale: app.locale}) }}">{{ 'upload.example'|trans }}</a>
                    {% endif %}
                    <button type="submit" class="button button--primary button--large" data-upload-target="submit">
                        <span class="button__label" data-upload-target="submitLabel">{{ 'upload.submit'|trans }}</span>
                        <span class="button__icon">{{ include('_icon.html.twig', {name: 'arrow-right'}) }}</span>
                        <span class="button__spinner" aria-hidden="true"></span>
                    </button>
                </div>
            </footer>
        {{ form_end(form) }}

        <section class="features" aria-labelledby="features-title" data-controller="reveal">
            <p class="eyebrow">{{ 'upload.features_eyebrow'|trans }}</p>
            <h2 class="section-title" id="features-title">{{ 'upload.features_title'|trans }}</h2>
            <div class="features__grid">
                {% for feature in ['grades', 'difficulty', 'discrimination'] %}
                    <article class="feature-card">
                        <span class="feature-card__icon">{{ include('_icon.html.twig', {name: feature == 'grades' ? 'grade' : (feature == 'difficulty' ? 'gauge' : 'trend')}) }}</span>
                        <h3>{{ ('upload.feature.' ~ feature ~ '.title')|trans }}</h3>
                        <p>{{ ('upload.feature.' ~ feature ~ '.text')|trans }}</p>
                    </article>
                {% endfor %}
            </div>
        </section>
    </main>
{% endblock %}
