    {%- elseif name == 'check' -%}
        <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- elseif name == 'x' -%}
        <path d="M18 6 6 18M6 6l12 12"/>
    {%- elseif name == 'plus' -%}
        <path d="M12 5v14M5 12h14"/>
    {%- elseif name == 'minus' -%}
        <path d="M5 12h14"/>
    {%- elseif name == 'search' -%}
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- elseif name == 'download' -%}
        <path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>
    {%- elseif name == 'copy' -%}
        <rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>
    {%- elseif name == 'arrow-right' -%}
        <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- elseif name == 'arrow-up' -%}
        <path d="M12 19V5M6 11l6-6 6 6"/>
    {%- elseif name == 'terminal' -%}
        <path d="m5 8 4 4-4 4"/><path d="M12 17h7"/>
    {%- elseif name == 'shield' -%}
        <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m9 12 2 2 4-4"/>
