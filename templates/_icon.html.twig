{#- Inline stroke icons (24×24). Usage: include('_icon.html.twig', {name: 'upload'}) -#}
<svg class="icon{{ class is defined ? ' ' ~ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
