<footer class="site-footer">
    <div class="container site-footer__inner">
        <div class="site-footer__brand">
            {{ include('_wordmark.html.twig', {light: true}) }}
            <p>{{ 'footer.tagline'|trans }}</p>
        </div>
        <ul class="site-footer__facts">
            <li>{{ include('_icon.html.twig', {name: 'shield'}) }} {{ 'footer.privacy'|trans }}</li>
            <li>{{ include('_icon.html.twig', {name: 'info'}) }} <a href="{{ path('app_analysis_help', {_locale: app.locale}) }}">{{ 'footer.help'|trans }}</a></li>
        </ul>
    </div>
</footer>
